# "groq" (free) or "anthropic" (paid, higher quality)
LLM_PROVIDER=groq

# Free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Voice AI platform: https://vapi.ai (free $5 credit, no card to start)
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=

VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# E.164 number Ava warm-transfers to on escalation (leave blank to hand off via the console only)
HUMAN_HANDOFF_NUMBER=
HUMAN_AGENT_NAME=Aarav
ENFORCE_CALLING_HOURS=false

# Filled in once the hackathon reveals the real journey-completion sandbox endpoint
JOURNEY_SANDBOX_URL=
